# CrewPane — local environment template.
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit real keys.
# Anon keys are public by design (protected by RLS) — service_role keys must NEVER go here.

# Renderer / app database (local Supabase by default)
NEXT_PUBLIC_CREWPANE_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_CREWPANE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CREWPANE_SUPABASE_SCHEMA=public

CREWPANE_APP_SUPABASE_URL=http://127.0.0.1:54321
CREWPANE_APP_SUPABASE_ANON_KEY=
CREWPANE_APP_SUPABASE_SCHEMA=public

# Identity provider (local Supabase Auth by default)
CREWPANE_ID_URL=http://127.0.0.1:54321
CREWPANE_ID_ANON_KEY=
CREWPANE_LOGIN_URL=

# Local development switches
CREWPANE_ALLOW_LOCAL_APP_DB=1
CREWPANE_ALLOW_MIXED_TARGETS=1
CREWPANE_INSTANCE=dev
CREWPANE_MODE=prod

# Task brain service (falls back to the public supabase-demo anon key when unset)
CREWPANE_TASKBRAIN_SUPABASE_URL=
CREWPANE_TASKBRAIN_ANON_KEY=
